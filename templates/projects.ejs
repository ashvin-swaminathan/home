<h1>Projects</h1>

<% projects.projects.forEach(function(project) { %>
<article class="project-entry" id="<%= project.id %>">

    <header class="project-header">
        <h2 class="project-title">
            <%= project.title %><% if (project.ai) { %><%- include('_partials/_ai-badge', { ai: project.ai }) %><% } %>
        </h2>
        <p class="project-meta">
            <span class="project-role"><%= project.role %></span>
            <% if (project.affiliation) { %>
                &middot; <a href="<%= project.affiliationUrl %>" target="_blank" rel="noopener"><%= project.affiliation %></a>
            <% } %>
            <% if (project.year) { %> &middot; <%= project.year %><% } %>
        </p>
        <% if (project.tagline) { %>
            <p class="project-tagline"><%- project.tagline %></p>
        <% } %>
        <%
        /* Text-chip links, in display order. `site` is the button and `x` is
           the logo, so neither appears here. */
        var LINK_LABELS = {
            github: 'github',
            zulip:  'zulip'
        };
        var linkKeys = Object.keys(LINK_LABELS).filter(function (k) { return project.links[k]; })
            .concat(Object.keys(project.links).filter(function (k) {
                return k !== 'site' && k !== 'x' && !LINK_LABELS[k];
            }));
        %>
        <div class="project-links">
            <% if (project.links.site) { %><a href="<%= project.links.site %>" class="btn btn-project" target="_blank" rel="noopener">Project site</a><% } %>
            <% linkKeys.forEach(function (k) { %>
                <a href="<%= project.links[k] %>" class="resource-tag" target="_blank" rel="noopener"><%= LINK_LABELS[k] || k %></a>
            <% }); %>
            <% if (project.links.x) { %>
                <a href="<%= project.links.x %>" class="social-link" target="_blank" rel="noopener" aria-label="Announcement thread on X" title="Announcement thread on X"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
            <% } %>
        </div>
    </header>

    <div class="project-body">
        <% if (project.summary) { %>
            <p class="project-summary"><%- project.summary %></p>
        <% } %>
        <% (project.description || []).forEach(function(para) { %>
            <p><%- para %></p>
        <% }); %>
    </div>

    <% if (project.outputs && project.outputs.length) { %>
        <section class="project-subsection">
            <h3><%= project.outputsHeading || 'Papers from the project' %></h3>
            <ul class="project-sources">
                <% project.outputs.forEach(function(item) { %>
                    <li>
                        <div class="source-citation"><%- item.citation %></div>
                        <% if (item.scope) { %><div class="source-scope"><%- item.scope %></div><% } %>
                        <% if (item.links) { %>
                            <div class="source-links">
                                <% Object.keys(item.links).forEach(function(k) { %>
                                    <a href="<%= item.links[k] %>" class="resource-tag" target="_blank" rel="noopener"><%= k %></a>
                                <% }); %>
                            </div>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        </section>
    <% } %>

    <% if (project.press && project.press.length) { %>
        <section class="project-subsection">
            <h3>Press</h3>
            <ul class="project-press">
                <% project.press.forEach(function(item) { %>
                    <li>
                        <span class="press-outlet"><%= item.outlet %></span>
                        <span class="press-body">
                            <a href="<%= item.url %>" target="_blank" rel="noopener"><%= item.title %></a><% if (item.byline) { %><span class="press-byline"><%= item.byline %></span><% } %>
                        </span>
                        <span class="press-date"><%= item.date %></span>
                    </li>
                <% }); %>
            </ul>
        </section>
    <% } %>

</article>
<% }); %>
