<%
/**
 * Rainbow "AI-assisted" sparkle.
 *
 * `ai` is { label, note }. The gradient it paints with (#ai-gradient) is
 * defined once per page in _layout.ejs, so this partial stays a single
 * lightweight element wherever it is repeated.
 */
var aiLabel = (ai && ai.label) ? ai.label : 'AI-assisted';
%><span class="ai-badge" tabindex="0" role="note" aria-label="<%= aiLabel %>">
    <svg class="ai-badge-icon" width="15" height="15" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 0c0 6.627 5.373 12 12 12-6.627 0-12 5.373-12 12 0-6.627-5.373-12-12-12C6.627 12 12 6.627 12 0z" fill="url(#ai-gradient)"/>
    </svg>
    <span class="ai-badge-label"><%= aiLabel %></span>
    <% if (ai && ai.note) { %>
        <span class="ai-badge-tip" role="tooltip"><%- ai.note %></span>
    <% } %>
</span>
